<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Correo de prueba de Monea</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #000000;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #000000;">
      <tr>
        <td align="center" style="padding: 48px 16px 40px;">

          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 520px;">
            <tr>
              <td align="center" style="padding: 0 0 28px;">
                {{#if hasLogo}}
                <img src="cid:{{logoCid}}" alt="Monea" width="96" height="96" style="display: block; width: 96px; height: 96px; object-fit: contain;" />
                {{else}}
                <div style="display: inline-block; color: #ff2fa0; font-size: 22px; font-weight: 800; letter-spacing: 6px;">MONEA</div>
                {{/if}}
              </td>
            </tr>

            <tr>
              <td align="center" style="padding: 0 0 8px;">
                <h1 style="margin: 0; color: #ffffff; font-size: 24px; line-height: 1.35; font-weight: 700; letter-spacing: -0.3px;">Correo de prueba</h1>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding: 0 24px 36px;">
                <p style="margin: 0; color: #9b9b9b; font-size: 15px; line-height: 1.6;">Hola {{name}}, esto confirma que el env&iacute;o de correos de Monea est&aacute; funcionando correctamente.</p>
              </td>
            </tr>
          </table>

          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 520px; border-top: 1px solid #1c1c1c;">
            <tr>
              <td align="center" style="padding: 28px 0 0;">
                <p style="margin: 0; color: #ff2fa0; font-size: 13px; font-weight: 800; letter-spacing: 4px;">MONEA</p>
                <p style="margin: 8px 0 0; color: #6d6d6d; font-size: 12px; line-height: 1.6;">No respondas a este correo. &copy; {{year}} Monea</p>
              </td>
            </tr>
          </table>

        </td>
      </tr>
    </table>
  </body>
</html>
