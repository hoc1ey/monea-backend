# Entorno de la aplicación
NODE_ENV=development
PORT=3000

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/db_name
DB_SYNCHRONIZE=true

# Redis
REDIS_URL=redis://localhost:6379

# JWT (mínimo 32 caracteres)
JWT_ACCESS_SECRET=monea_super_secret_access_token_32chars_min
JWT_REFRESH_SECRET=monea_super_secret_refresh_token_32chars_min
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_DAYS=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STRICT_LIMIT=5
RATE_LIMIT_STRICT_TTL_SECONDS=60
RATE_LIMIT_STRICT_BLOCK_SECONDS=60
RATE_LIMIT_RELAXED_LIMIT=30
RATE_LIMIT_RELAXED_TTL_SECONDS=60
RATE_LIMIT_RELAXED_BLOCK_SECONDS=60

# Bloqueos de cuenta e IP (en minutos)
ACCOUNT_LOCK_5_MINUTES=15
ACCOUNT_LOCK_7_MINUTES=30
ACCOUNT_LOCK_8_MINUTES=120
ACCOUNT_LOCK_9_PLUS_MINUTES=300
IP_LOCK_WINDOW_MINUTES=5
IP_LOCK_MINUTES=15

# Notificaciones (Firebase Cloud Messaging - Service Account Base64)
FIREBASE_SERVICE_ACCOUNT_BASE64=e30=

# Correo electrónico (SMTP de Gmail)
# Requiere verificación en 2 pasos y una "Contraseña de aplicación" de 16 caracteres.
# Para el puerto 587 usa MAIL_SECURE=false (STARTTLS).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=tu_cuenta@gmail.com
MAIL_PASSWORD=tu_app_password_de_16_caracteres
MAIL_FROM=tu_cuenta@gmail.com
MAIL_FROM_NAME=Monea
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15

# Configuración horaria y tareas programadas
DEFAULT_TIMEZONE=America/Bogota
SCHEDULER_ENABLED=true
